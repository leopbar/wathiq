# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Demo mode needs NOTHING from this file: the defaults already work offline.

# ---------- core ----------
WATHIQ_MODE=demo                 # demo | azure
WATHIQ_LOG_LEVEL=INFO
WATHIQ_BUILD_SHA=dev

# ---------- database ----------
POSTGRES_USER=wathiq
POSTGRES_PASSWORD=wathiq
POSTGRES_DB=wathiq
DB_PORT=55432

# ---------- ports ----------
API_PORT=8000
WEB_PORT=5173
CONDUCTOR_PORT=8080
CONDUCTOR_UI_PORT=5000

# ---------- auth (demo mode) ----------
# Change this before showing the app to anyone outside your machine.
WATHIQ_JWT_SECRET=dev-only-insecure-secret-change-me
WATHIQ_DEMO_PASSWORD=Wathiq!Demo2026

# ---------- azure mode only ----------
# Fill these in and set WATHIQ_MODE=azure. Keys live here or in Key Vault, never in code.
WATHIQ_AZURE_OPENAI_ENDPOINT=
WATHIQ_AZURE_OPENAI_DEPLOYMENT=
WATHIQ_AZURE_OPENAI_API_KEY=
WATHIQ_AZURE_DOC_INTELLIGENCE_ENDPOINT=
WATHIQ_AZURE_DOC_INTELLIGENCE_KEY=
WATHIQ_AZURE_CONTENT_SAFETY_ENDPOINT=
WATHIQ_AZURE_CONTENT_SAFETY_KEY=
WATHIQ_AZURE_SEARCH_ENDPOINT=
WATHIQ_AZURE_SEARCH_KEY=
WATHIQ_AZURE_SEARCH_INDEX=wathiq-policies
WATHIQ_AZURE_STORAGE_ACCOUNT_URL=
WATHIQ_AZURE_MONITOR_CONNECTION_STRING=
WATHIQ_ENTRA_TENANT_ID=
WATHIQ_ENTRA_CLIENT_ID=
