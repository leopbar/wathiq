# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Demo mode needs NOTHING from this file: the defaults already work offline.

# ---------- core ----------
WATHIQ_LOG_LEVEL=INFO
WATHIQ_BUILD_SHA=dev

# ---------- database ----------
POSTGRES_USER=wathiq
POSTGRES_PASSWORD=wathiq
POSTGRES_DB=wathiq
DB_PORT=55432

# ---------- ports ----------
API_PORT=8000
WEB_PORT=5173
CONDUCTOR_PORT=8080
CONDUCTOR_UI_PORT=5000

# ---------- auth (demo mode) ----------
# Change this before showing the app to anyone outside your machine.
WATHIQ_JWT_SECRET=dev-only-insecure-secret-change-me
WATHIQ_DEMO_PASSWORD=Wathiq!Demo2026

# ---------- azure mode only ----------
# Set WATHIQ_MODE=azure, then fill in ONLY the services you want. Each one is switched on by
# its own endpoint: an empty endpoint means that service stays on its demo implementation and
# the Settings > Azure tab says so. A half-configured deployment is a normal state, not a
# broken one — real OCR with the demo extractor, for instance, is a sensible way to start.
#
# KEYS ARE OPTIONAL AND ARE THE FALLBACK, NOT THE DEFAULT. Leave a key empty and the adapter
# authenticates with Microsoft Entra (`DefaultAzureCredential`) — on AKS that is the pod's
# workload identity, and no key exists anywhere. Set a key only when running against a real
# service from a machine that has no managed identity. Never commit a filled-in .env.
WATHIQ_MODE=demo

# --- models (Azure AI Foundry) ---
WATHIQ_AZURE_OPENAI_ENDPOINT=
WATHIQ_AZURE_OPENAI_DEPLOYMENT=
WATHIQ_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# 256 to match the `vector(256)` column the policy index already uses. Changing it means
# re-indexing: vectors from two different models are not comparable.
WATHIQ_AZURE_OPENAI_EMBEDDING_DIMENSIONS=256
WATHIQ_AZURE_OPENAI_API_VERSION=2024-10-21
WATHIQ_AZURE_OPENAI_API_KEY=
# 0 by default. A regression suite cannot hold an extractor to an answer that changes run to run.
WATHIQ_AZURE_OPENAI_TEMPERATURE=0.0

# --- OCR (Document Intelligence) ---
WATHIQ_AZURE_DOC_INTELLIGENCE_ENDPOINT=
WATHIQ_AZURE_DOC_INTELLIGENCE_KEY=
# prebuilt-layout: words, lines, polygons and confidences. We map fields ourselves against the
# schema we version, rather than taking the service's inferred key-value pairs.
WATHIQ_AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

# --- guardrails (Content Safety + Prompt Shields) ---
# Joins the local detectors rather than replacing them: either one flagging sends the case to
# a person.
WATHIQ_AZURE_CONTENT_SAFETY_ENDPOINT=
WATHIQ_AZURE_CONTENT_SAFETY_KEY=

# --- RAG (Azure AI Search) ---
# Leave empty to keep the pgvector retriever, which already returns real policy citations.
WATHIQ_AZURE_SEARCH_ENDPOINT=
WATHIQ_AZURE_SEARCH_KEY=
WATHIQ_AZURE_SEARCH_INDEX=wathiq-policies

# --- document storage (ADLS Gen2) ---
WATHIQ_AZURE_STORAGE_ACCOUNT_URL=
WATHIQ_AZURE_STORAGE_FILESYSTEM=documents
WATHIQ_AZURE_STORAGE_KEY=
# How long a viewer's SAS link lives. Short on purpose.
WATHIQ_AZURE_STORAGE_SAS_MINUTES=15

# --- calibration (Azure ML) ---
WATHIQ_AZURE_ML_SUBSCRIPTION_ID=
WATHIQ_AZURE_ML_RESOURCE_GROUP=
WATHIQ_AZURE_ML_WORKSPACE=
WATHIQ_AZURE_ML_COMPUTE=wathiq-cpu

# --- tracing (Azure Monitor) ---
# Works in either mode. Empty means spans are not exported and cost a dictionary lookup each.
WATHIQ_AZURE_MONITOR_CONNECTION_STRING=

# --- sign-in (Microsoft Entra ID) ---
# demo = local accounts with a Wathiq-signed JWT. entra = validate Entra tokens against the
# tenant's JWKS, with the app role in the token deciding the Wathiq role.
WATHIQ_AUTH_BACKEND=demo
WATHIQ_ENTRA_TENANT_ID=
WATHIQ_ENTRA_CLIENT_ID=
WATHIQ_ENTRA_CLIENT_SECRET=
