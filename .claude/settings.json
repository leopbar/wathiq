{
  "permissions": {
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(gh repo create*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(docker push*)",
      "Bash(az*)"
    ],
    "deny": [
      "Bash(git push* --force*)",
      "Bash(git push* -f*)",
      "Bash(git reset --hard*)",
      "Read(./.env)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
